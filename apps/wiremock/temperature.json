{
  "request": {
    "method": "GET",
    "urlPath": "/temperature",
    "queryParameters": {
      "location": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "location": "{{request.query.location}}",
      "value": 22.5,
      "unit": "C",
      "timestamp": "2025-10-18T19:00:00Z"
    },
    "transformers": [
      "response-template"
    ],
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
